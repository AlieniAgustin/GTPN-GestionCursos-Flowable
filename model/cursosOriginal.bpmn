  <bpmn:process id="Process_Curso" name="Organizar curso de capacitación" isExecutable="false">
    <bpmn:documentation>Modelo conceptual, no ejecutable. Los recordatorios se cuentan por versión de propuesta. La fecha programada se obtiene de la propuesta aceptada. Para cada participante se espera una respuesta de encuesta; el enunciado no fija un vencimiento. La empresa se representa como pool de caja negra; los mensajes internos del subproceso se expresan con tareas de envío/recepción y eventos de mensaje.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_0ilhqvy">
      <bpmn:lane id="Lane_0sq5phl" name="Docentes">
        <bpmn:flowNodeRef>Dictar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fecha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Informe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1018bdz</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_04yvzzz" name="Administración">
        <bpmn:flowNodeRef>Esperar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Recordatorio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Limite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Plazo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Aceptar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Modificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_12e0et1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_0w2kitf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Archivar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FinSinCurso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rechazar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Propuesta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_10gftrn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1xw400l</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_18edb9q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0iibzwu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Confirmar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Preparar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_0farfur</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Revisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EnviarInforme</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1eg7zcl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Enviar</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:eventBasedGateway id="Esperar" name="Esperar respuesta">
      <bpmn:incoming>VolverEsperar</bpmn:incoming>
      <bpmn:incoming>main3</bpmn:incoming>
      <bpmn:outgoing>wait0</bpmn:outgoing>
      <bpmn:outgoing>wait1</bpmn:outgoing>
      <bpmn:outgoing>wait2</bpmn:outgoing>
      <bpmn:outgoing>wait3</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:startEvent id="Inicio" name="Solicitud recibida">
      <bpmn:outgoing>Flow_0g8vm9l</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_Inicio" messageRef="Msg_sol" />
    </bpmn:startEvent>
    <bpmn:scriptTask id="Recordatorio" name="Enviar recordatorio">
      <bpmn:incoming>OtroRecord</bpmn:incoming>
      <bpmn:outgoing>VolverEsperar</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Limite" name="¿Se enviaron 2 recordatorios?">
      <bpmn:incoming>PlazoLimite</bpmn:incoming>
      <bpmn:outgoing>SinRespuesta</bpmn:outgoing>
      <bpmn:outgoing>OtroRecord</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Plazo" name="5 días">
      <bpmn:incoming>wait3</bpmn:incoming>
      <bpmn:outgoing>PlazoLimite</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_Plazo">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Aceptar" name="Aceptación">
      <bpmn:incoming>wait0</bpmn:incoming>
      <bpmn:outgoing>Flow_05hw5hu</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_Aceptar" messageRef="Msg_acepta" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Modificar" name="Modificaciones">
      <bpmn:incoming>wait2</bpmn:incoming>
      <bpmn:outgoing>ModificarProp</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_Modificar" messageRef="Msg_mod" />
    </bpmn:intermediateCatchEvent>
    <bpmn:dataObjectReference id="DatosPropuesta" name="Propuesta y presupuesto" dataObjectRef="DatosPropuesta_Object" />
    <bpmn:dataObject id="DatosPropuesta_Object" />
    <bpmn:sequenceFlow id="main3" sourceRef="Enviar" targetRef="Esperar" />
    <bpmn:sequenceFlow id="VolverEsperar" sourceRef="Recordatorio" targetRef="Esperar" />
    <bpmn:sequenceFlow id="wait3" sourceRef="Esperar" targetRef="Plazo" />
    <bpmn:sequenceFlow id="wait0" sourceRef="Esperar" targetRef="Aceptar" />
    <bpmn:sequenceFlow id="wait1" sourceRef="Esperar" targetRef="Rechazar" />
    <bpmn:sequenceFlow id="wait2" sourceRef="Esperar" targetRef="Modificar" />
    <bpmn:sequenceFlow id="CerrarSolicitud" sourceRef="Archivar" targetRef="FinSinCurso" />
    <bpmn:sequenceFlow id="main2" sourceRef="Propuesta" targetRef="Enviar" />
    <bpmn:sequenceFlow id="Flow_0upbxn5" sourceRef="Revisar" targetRef="Enviar" />
    <bpmn:sequenceFlow id="OtroRecord" name="No" sourceRef="Limite" targetRef="Recordatorio">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${recordatorios &lt; 2}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PlazoLimite" sourceRef="Plazo" targetRef="Limite" />
    <bpmn:sequenceFlow id="SinRespuesta" name="Sí" sourceRef="Limite" targetRef="Archivar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${recordatorios &gt;= 2}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Rechazado" sourceRef="Rechazar" targetRef="Archivar" />
    <bpmn:sequenceFlow id="ModificarProp" sourceRef="Modificar" targetRef="Revisar" />
    <bpmn:sequenceFlow id="Flow_175t1j3" sourceRef="Activity_12e0et1" targetRef="Event_0w2kitf" />
    <bpmn:sequenceFlow id="Flow_1ymw5qe" sourceRef="Event_0farfur" targetRef="Activity_12e0et1" />
    <bpmn:sequenceFlow id="Preparado" sourceRef="Preparar" targetRef="Confirmar" />
    <bpmn:scriptTask id="Activity_12e0et1" name="Notificar Cierre">
      <bpmn:incoming>Flow_1ymw5qe</bpmn:incoming>
      <bpmn:outgoing>Flow_175t1j3</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="Event_0w2kitf">
      <bpmn:incoming>Flow_175t1j3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Archivar" name="Archivar solicitud">
      <bpmn:incoming>Rechazado</bpmn:incoming>
      <bpmn:incoming>SinRespuesta</bpmn:incoming>
      <bpmn:outgoing>CerrarSolicitud</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="FinSinCurso" name="Solicitud cerrada">
      <bpmn:incoming>CerrarSolicitud</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Rechazar" name="Rechazo">
      <bpmn:incoming>wait1</bpmn:incoming>
      <bpmn:outgoing>Rechazado</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_Rechazar" messageRef="Msg_rechaza" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Dictar" name="Desarrollar curso">
      <bpmn:incoming>FechaDictar</bpmn:incoming>
      <bpmn:outgoing>Flow_1sdjeh6</bpmn:outgoing>
      <bpmn:property id="Property_137on16" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_0pu7q61">
        <bpmn:sourceRef>DatosLista</bpmn:sourceRef>
        <bpmn:targetRef>Property_137on16</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Fecha" name="Fecha programada">
      <bpmn:incoming>Flow_0lscijk</bpmn:incoming>
      <bpmn:outgoing>FechaDictar</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_Fecha">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${fechaCurso}</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="FechaDictar" sourceRef="Fecha" targetRef="Dictar" />
    <bpmn:sequenceFlow id="Flow_1sdjeh6" sourceRef="Dictar" targetRef="Informe" />
    <bpmn:subProcess id="Preparar" name="Preparar curso">
      <bpmn:incoming>Flow_1ffpwga</bpmn:incoming>
      <bpmn:outgoing>Preparado</bpmn:outgoing>
      <bpmn:startEvent id="SubInicio" name="">
        <bpmn:outgoing>s1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:parallelGateway id="ParInicio" name="Preparación en paralelo">
        <bpmn:incoming>s1</bpmn:incoming>
        <bpmn:outgoing>s2</bpmn:outgoing>
        <bpmn:outgoing>s5</bpmn:outgoing>
        <bpmn:outgoing>s6</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:receiveTask id="Nomina" name="Recibir nómina">
        <bpmn:incoming>s2</bpmn:incoming>
        <bpmn:outgoing>Flow_1j917g3</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:userTask id="Lista" name="Confeccionar lista definitiva">
        <bpmn:incoming>Flow_1j917g3</bpmn:incoming>
        <bpmn:outgoing>Flow_1q09oq9</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="DataOutputAssociation_1uk8xt0">
          <bpmn:targetRef>DatosLista</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:userTask>
      <bpmn:userTask id="Material" name="Preparar materiales">
        <bpmn:incoming>s5</bpmn:incoming>
        <bpmn:outgoing>Flow_0pbsav2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:inclusiveGateway id="OrInicio" name="Recursos necesarios">
        <bpmn:incoming>Flow_0r6hcyb</bpmn:incoming>
        <bpmn:outgoing>or0</bpmn:outgoing>
        <bpmn:outgoing>or1</bpmn:outgoing>
        <bpmn:outgoing>or2</bpmn:outgoing>
      </bpmn:inclusiveGateway>
      <bpmn:userTask id="Virtual" name="Solicitar Aula Virtual">
        <bpmn:incoming>or1</bpmn:incoming>
        <bpmn:outgoing>oj1</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="Equipo" name="Contratar equipamiento">
        <bpmn:incoming>or2</bpmn:incoming>
        <bpmn:outgoing>oj2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:inclusiveGateway id="OrFin" name="Todos los recursos seleccionados listos">
        <bpmn:incoming>oj0</bpmn:incoming>
        <bpmn:incoming>oj1</bpmn:incoming>
        <bpmn:incoming>oj2</bpmn:incoming>
        <bpmn:outgoing>s11</bpmn:outgoing>
      </bpmn:inclusiveGateway>
      <bpmn:parallelGateway id="ParFin" name="Preparación completa">
        <bpmn:incoming>s11</bpmn:incoming>
        <bpmn:incoming>Flow_1q09oq9</bpmn:incoming>
        <bpmn:incoming>Flow_0pbsav2</bpmn:incoming>
        <bpmn:outgoing>s12</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:endEvent id="SubFin" name="">
        <bpmn:incoming>s12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="s1" sourceRef="SubInicio" targetRef="ParInicio" />
      <bpmn:sequenceFlow id="s2" sourceRef="ParInicio" targetRef="Nomina" />
      <bpmn:sequenceFlow id="s5" sourceRef="ParInicio" targetRef="Material" />
      <bpmn:sequenceFlow id="s6" sourceRef="ParInicio" targetRef="Activity_12i2hpf" />
      <bpmn:sequenceFlow id="or0" name="Presencial" sourceRef="OrInicio" targetRef="Aula">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${requiereAula}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="oj0" sourceRef="Aula" targetRef="OrFin" />
      <bpmn:sequenceFlow id="or1" name="Virtual" sourceRef="OrInicio" targetRef="Virtual">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${requierePlataforma}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="oj1" sourceRef="Virtual" targetRef="OrFin" />
      <bpmn:sequenceFlow id="or2" name="Equipamiento especial" sourceRef="OrInicio" targetRef="Equipo">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${requiereEquipamiento}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="oj2" sourceRef="Equipo" targetRef="OrFin" />
      <bpmn:sequenceFlow id="s11" sourceRef="OrFin" targetRef="ParFin" />
      <bpmn:sequenceFlow id="s12" sourceRef="ParFin" targetRef="SubFin" />
      <bpmn:dataObject id="DatosLista_Object" />
      <bpmn:dataObjectReference id="DatosLista" name="Lista definitiva" dataObjectRef="DatosLista_Object" />
      <bpmn:sequenceFlow id="Flow_0r6hcyb" sourceRef="Activity_12i2hpf" targetRef="OrInicio" />
      <bpmn:userTask id="Activity_12i2hpf" name="Evaluar&#10;Recursos">
        <bpmn:incoming>s6</bpmn:incoming>
        <bpmn:outgoing>Flow_0r6hcyb</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:subProcess id="Activity_048d5em" name="Cancelación" triggeredByEvent="true">
        <bpmn:sequenceFlow id="Flow_099pqle" sourceRef="Event_1g4xmqo" targetRef="Event_1rvo4k6" />
        <bpmn:intermediateThrowEvent id="Event_1rvo4k6">
          <bpmn:incoming>Flow_099pqle</bpmn:incoming>
          <bpmn:outgoing>Flow_0h5si5f</bpmn:outgoing>
          <bpmn:compensateEventDefinition id="CompensateEventDefinition_0vae6de" />
        </bpmn:intermediateThrowEvent>
        <bpmn:startEvent id="Event_1g4xmqo" name="Recibir Cancelación">
          <bpmn:outgoing>Flow_099pqle</bpmn:outgoing>
          <bpmn:messageEventDefinition id="MessageEventDefinition_1avzsle" />
        </bpmn:startEvent>
        <bpmn:sequenceFlow id="Flow_0h5si5f" sourceRef="Event_1rvo4k6" targetRef="Event_0snigbc" />
        <bpmn:endEvent id="Event_0snigbc">
          <bpmn:incoming>Flow_0h5si5f</bpmn:incoming>
          <bpmn:errorEventDefinition id="ErrorEventDefinition_0dmehr3" />
        </bpmn:endEvent>
      </bpmn:subProcess>
      <bpmn:boundaryEvent id="Event_0rm0c02" attachedToRef="Aula">
        <bpmn:compensateEventDefinition id="CompensateEventDefinition_10syb4w" />
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="Flow_0pbsav2" sourceRef="Material" targetRef="ParFin" />
      <bpmn:sequenceFlow id="Flow_1q09oq9" sourceRef="Lista" targetRef="ParFin" />
      <bpmn:boundaryEvent id="Event_1gsyqer" attachedToRef="Virtual">
        <bpmn:compensateEventDefinition id="CompensateEventDefinition_1n13dna" />
      </bpmn:boundaryEvent>
      <bpmn:boundaryEvent id="Event_1ypcc1j" attachedToRef="Equipo">
        <bpmn:compensateEventDefinition id="CompensateEventDefinition_1weqaul" />
      </bpmn:boundaryEvent>
