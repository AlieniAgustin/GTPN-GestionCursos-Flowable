      </bpmn:serviceTask>
      <bpmn:serviceTask id="Activity_16zz91p" name="Liberar Aula" isForCompensation="true" />
      <bpmn:sequenceFlow id="Flow_1j917g3" sourceRef="Nomina" targetRef="Lista" />
      <bpmn:scriptTask id="Activity_02hrooc" name="Liberar Aula Virtual" isForCompensation="true" />
      <bpmn:association id="Association_1fh67xn" associationDirection="One" sourceRef="Event_0rm0c02" targetRef="Activity_16zz91p" />
      <bpmn:association id="Association_0oqohax" associationDirection="One" sourceRef="Event_1ypcc1j" targetRef="Activity_1m08pcl" />
